THB_ENV=development
THB_LOG_LEVEL=INFO

# Copy this file to .env and provide real credentials there. Never commit secrets.
THB_LLM_API_KEY=
THB_STRIP_MODEL=gpt-5.6-sol
THB_EXTRACT_MODEL=gpt-5.6-sol
THB_LLM_BASE_URL=https://open.oproxy.world/v1
THB_LLM_API_STYLE=responses

THB_LLM_TIMEOUT=30
THB_LLM_MAX_RETRIES=2
THB_STRIP_VALIDATION_RETRIES=1
THB_STRIP_TEMPERATURE=0
THB_STRIP_MAX_TOKENS=4096
THB_STRIP_OUTPUT_MODE=json_schema
THB_EXTRACT_VALIDATION_RETRIES=2
THB_EXTRACT_TEMPERATURE=0
THB_EXTRACT_MAX_TOKENS=8192
THB_EXTRACT_OUTPUT_MODE=json_schema
THB_EXTRACT_TIMEOUT=120
